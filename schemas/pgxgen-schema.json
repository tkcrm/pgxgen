{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pgxgen configuration",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1"],
      "description": "Configuration version"
    },
    "sqlc": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sqlcConfig"
      }
    },
    "generate": {
      "$ref": "#/definitions/generateConfig"
    }
  },
  "definitions": {
    "sqlcConfig": {
      "type": "object",
      "properties": {
        "schema_dir": {
          "type": "string",
          "description": "Directory with migrations. Required."
        },
        "models": {
          "$ref": "#/definitions/modelsConfig"
        },
        "crud": {
          "$ref": "#/definitions/crudConfig"
        },
        "constants": {
          "$ref": "#/definitions/constantsConfig"
        }
      },
      "required": ["schema_dir"]
    },
    "modelsConfig": {
      "type": "object",
      "properties": {
        "replace_sqlc_nullable_types": {
          "type": "boolean",
          "description": "Replace nullable types. Ex: sql.NullInt32 -> *int32"
        },
        "include_struct_comments": {
          "type": "boolean",
          "description": "Include comments for structs. Useful for swagger generation"
        },
        "move": {
          "type": "object",
          "properties": {
            "output_dir": {
              "type": "string",
              "description": "Output directory for models"
            },
            "output_file_name": {
              "type": "string",
              "description": "Output file name. Default: models.go"
            },
            "package_name": {
              "type": "string",
              "description": "New package name. By default based on output_dir"
            },
            "package_path": {
              "type": "string",
              "description": "Full path to new models directory. Required."
            },
            "imports": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Import path. Required."
                  },
                  "go_type": {
                    "type": "string",
                    "description": "Use path if this type detected in file"
                  }
                },
                "required": ["path"]
              }
            }
          },
          "required": ["output_dir", "package_path"]
        }
      }
    },
    "crudConfig": {
      "type": "object",
      "properties": {
        "auto_remove_generated_files": {
          "type": "boolean",
          "description": "Auto remove generated files ending with _gen.sql"
        },
        "exclude_table_name_from_methods": {
          "type": "boolean",
          "description": "Instead [ActionName][TableName] will be [ActionName]. Example: GetUser -> Get"
        },
        "tables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/tableConfig"
          }
        }
      }
    },
    "tableConfig": {
      "type": "object",
      "properties": {
        "output_dir": {
          "type": "string",
          "description": "Output directory for generated SQL"
        },
        "primary_column": {
          "type": "string",
          "description": "Primary key column name"
        },
        "methods": {
          "type": "object",
          "properties": {
            "get": {
              "$ref": "#/definitions/getMethodConfig"
            },
            "find": {
              "$ref": "#/definitions/findMethodConfig"
            },
            "create": {
              "$ref": "#/definitions/createMethodConfig"
            },
            "update": {
              "$ref": "#/definitions/updateMethodConfig"
            },
            "delete": {
              "$ref": "#/definitions/deleteMethodConfig"
            },
            "total": {
              "$ref": "#/definitions/totalMethodConfig"
            },
            "exists": {
              "$ref": "#/definitions/existsMethodConfig"
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/customMethodConfig"
          }
        }
      }
    },
    "getMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        }
      }
    },
    "findMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        },
        "skip_columns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Columns to skip in result"
        },
        "where": {
          "$ref": "#/definitions/whereConfig"
        },
        "where_additional": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional WHERE clauses"
        },
        "order": {
          "$ref": "#/definitions/orderConfig"
        },
        "limit": {
          "type": "boolean",
          "description": "Enable LIMIT parameter"
        },
        "offset": {
          "type": "boolean",
          "description": "Enable OFFSET parameter"
        }
      }
    },
    "createMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        },
        "skip_columns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Columns to skip in INSERT"
        },
        "column_values": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Default column values. Ex: created_at: now()"
        },
        "returning": {
          "type": "string",
          "description": "RETURNING clause. Use '*' for all columns"
        }
      }
    },
    "updateMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        },
        "skip_columns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Columns to skip in UPDATE"
        },
        "column_values": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Default column values. Ex: updated_at: now()"
        },
        "returning": {
          "type": "string",
          "description": "RETURNING clause. Use '*' for all columns"
        }
      }
    },
    "deleteMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        }
      }
    },
    "totalMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        }
      }
    },
    "existsMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        },
        "where": {
          "$ref": "#/definitions/whereConfig"
        }
      }
    },
    "customMethodConfig": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Custom method name"
        },
        "skip_columns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "where": {
          "$ref": "#/definitions/whereConfig"
        },
        "where_additional": {
          "type": "array",
          "items": { "type": "string" }
        },
        "order": {
          "$ref": "#/definitions/orderConfig"
        },
        "limit": {
          "type": "boolean"
        },
        "offset": {
          "type": "boolean"
        },
        "column_values": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "returning": {
          "type": "string"
        }
      }
    },
    "whereConfig": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "operator": {
            "type": "string",
            "description": "Comparison operator. Ex: '!=', '>', '<'"
          },
          "value": {
            "type": "string",
            "description": "Value or expression. Ex: 'IS NULL', '= $1'"
          }
        }
      }
    },
    "orderConfig": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "description": "Column to order by"
        },
        "direction": {
          "type": "string",
          "enum": ["ASC", "DESC"],
          "description": "Sort direction"
        }
      }
    },
    "constantsConfig": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "output_dir": {
                "type": "string"
              },
              "include_column_names": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "generateConfig": {
      "type": "object",
      "description": "Code generation settings",
      "properties": {
        "models": {
          "type": "array",
          "description": "Generate Go models for all tables from SQL schema",
          "items": {
            "$ref": "#/definitions/generateModelsConfig"
          }
        }
      }
    },
    "generateModelsConfig": {
      "type": "object",
      "description": "Configuration for generating Go model structs from SQL schema files",
      "properties": {
        "schema_dir": {
          "type": "string",
          "description": "Directory with SQL schema/migration files. Required."
        },
        "engine": {
          "type": "string",
          "enum": ["postgresql", "mysql", "sqlite"],
          "default": "postgresql",
          "description": "Database engine. Default: postgresql"
        },
        "output_dir": {
          "type": "string",
          "description": "Output directory for generated Go models. Required."
        },
        "output_file_name": {
          "type": "string",
          "default": "models.go",
          "description": "Output file name. Default: models.go"
        },
        "package_name": {
          "type": "string",
          "description": "Go package name for generated file. Required."
        },
        "sql_package": {
          "type": "string",
          "enum": ["pgx/v5", "pgx/v4", "database/sql"],
          "default": "database/sql",
          "description": "SQL driver package for type mapping. Default: database/sql"
        },
        "emit_json_tags": {
          "type": "boolean",
          "default": false,
          "description": "Add json struct tags to generated fields"
        },
        "emit_db_tags": {
          "type": "boolean",
          "default": false,
          "description": "Add db struct tags to generated fields"
        },
        "emit_pointers_for_null": {
          "type": "boolean",
          "default": false,
          "description": "Use pointers for nullable types instead of sql.Null* wrappers"
        }
      },
      "required": ["schema_dir", "output_dir", "package_name"]
    }
  }
}
